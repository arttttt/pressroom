{
	// The Node side: main process, preload, and the domain they carry. No DOM.
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023"],
		"types": ["node"]
	},
	"include": [
		"electron.vite.config.ts",
		"src/main/**/*.ts",
		"src/preload/**/*.ts",
		"src/domain/**/*.ts",
		"src/shared/**/*.ts"
	]
}
